DEFINE
VAR AllMeasures = UNION(
ROW("Measure", "Total Forecasted Units", "Result", IFERROR(FORMAT([Total Forecasted Units], "0.000000"), "ERROR")),
ROW("Measure", "Average Daily Forecast", "Result", IFERROR(FORMAT([Average Daily Forecast], "0.000000"), "ERROR")),
ROW("Measure", "Stores", "Result", IFERROR(FORMAT([Stores], "0.000000"), "ERROR")),
ROW("Measure", "Product Families", "Result", IFERROR(FORMAT([Product Families], "0.000000"), "ERROR")),
ROW("Measure", "Combinations", "Result", IFERROR(FORMAT([Combinations], "0.000000"), "ERROR")),
ROW("Measure", "Average Risk Score", "Result", IFERROR(FORMAT([Average Risk Score], "0.000000"), "ERROR")),
ROW("Measure", "High Risk Count", "Result", IFERROR(FORMAT([High Risk Count], "0.000000"), "ERROR")),
ROW("Measure", "Critical Risk Count", "Result", IFERROR(FORMAT([Critical Risk Count], "0.000000"), "ERROR")),
ROW("Measure", "High Critical Count", "Result", IFERROR(FORMAT([High Critical Count], "0.000000"), "ERROR")),
ROW("Measure", "High Critical Percentage", "Result", IFERROR(FORMAT([High Critical Percentage], "0.000000"), "ERROR")),
ROW("Measure", "P1 Actions", "Result", IFERROR(FORMAT([P1 Actions], "0.000000"), "ERROR")),
ROW("Measure", "P2 Actions", "Result", IFERROR(FORMAT([P2 Actions], "0.000000"), "ERROR")),
ROW("Measure", "P3 Actions", "Result", IFERROR(FORMAT([P3 Actions], "0.000000"), "ERROR")),
ROW("Measure", "Surge Risk", "Result", IFERROR(FORMAT([Surge Risk], "0.000000"), "ERROR")),
ROW("Measure", "Decline Risk", "Result", IFERROR(FORMAT([Decline Risk], "0.000000"), "ERROR")),
ROW("Measure", "Volatility Risk", "Result", IFERROR(FORMAT([Volatility Risk], "0.000000"), "ERROR")),
ROW("Measure", "Forecast Uncertainty", "Result", IFERROR(FORMAT([Forecast Uncertainty], "0.000000"), "ERROR")),
ROW("Measure", "At Risk Forecasted Units", "Result", IFERROR(FORMAT([At Risk Forecasted Units], "0.000000"), "ERROR")),
ROW("Measure", "At Risk Exposure Share", "Result", IFERROR(FORMAT([At Risk Exposure Share], "0.000000"), "ERROR")),
ROW("Measure", "Promotion Associated Units", "Result", IFERROR(FORMAT([Promotion Associated Units], "0.000000"), "ERROR")),
ROW("Measure", "Promotion Associated Share", "Result", IFERROR(FORMAT([Promotion Associated Share], "0.000000"), "ERROR")),
ROW("Measure", "Snapshot Forecast Units", "Result", IFERROR(FORMAT([Snapshot Forecast Units], "0.000000"), "ERROR")),
ROW("Measure", "Historical Daily Baseline", "Result", IFERROR(FORMAT([Historical Daily Baseline], "0.000000"), "ERROR")),
ROW("Measure", "Eligible Forecast Growth", "Result", IFERROR(FORMAT([Eligible Forecast Growth], "0.000000"), "ERROR")),
ROW("Measure", "Series Forecast Units", "Result", IFERROR(FORMAT([Series Forecast Units], "0.000000"), "ERROR")),
ROW("Measure", "Priority Score", "Result", IFERROR(FORMAT([Priority Score], "0.000000"), "ERROR")),
ROW("Measure", "Store Validation RMSLE", "Result", IFERROR(FORMAT([Store Validation RMSLE], "0.000000"), "ERROR")),
ROW("Measure", "Family Validation RMSLE", "Result", IFERROR(FORMAT([Family Validation RMSLE], "0.000000"), "ERROR")),
ROW("Measure", "Selected Model RMSLE", "Result", IFERROR(FORMAT([Selected Model RMSLE], "0.000000"), "ERROR")),
ROW("Measure", "Baseline RMSLE", "Result", IFERROR(FORMAT([Baseline RMSLE], "0.000000"), "ERROR")),
ROW("Measure", "Relative Model Improvement", "Result", IFERROR(FORMAT([Relative Model Improvement], "0.000000"), "ERROR")),
ROW("Measure", "Model RMSLE", "Result", IFERROR(FORMAT([Model RMSLE], "0.000000"), "ERROR")),
ROW("Measure", "Fold RMSLE", "Result", IFERROR(FORMAT([Fold RMSLE], "0.000000"), "ERROR")),
ROW("Measure", "Feature Gain Share", "Result", IFERROR(FORMAT([Feature Gain Share], "0.000000"), "ERROR")),
ROW("Measure", "Top 10 Store Forecast", "Result", IFERROR(FORMAT([Top 10 Store Forecast], "0.000000"), "ERROR")),
ROW("Measure", "Top 10 Family Forecast", "Result", IFERROR(FORMAT([Top 10 Family Forecast], "0.000000"), "ERROR")),
ROW("Measure", "Highest Risk Store", "Result", IFERROR(FORMAT([Highest Risk Store], ""), "ERROR")),
ROW("Measure", "Highest Risk Family", "Result", IFERROR(FORMAT([Highest Risk Family], ""), "ERROR")),
ROW("Measure", "Context Title", "Result", IFERROR(FORMAT([Context Title], ""), "ERROR")),
ROW("Measure", "Risk Color", "Result", IFERROR(FORMAT([Risk Color], ""), "ERROR")),
ROW("Measure", "Risk Heat Color", "Result", IFERROR(FORMAT([Risk Heat Color], ""), "ERROR"))
)
EVALUATE
UNION(
ROW("Check","All 41 measures evaluate","Pass",COUNTROWS(FILTER(AllMeasures, [Result] = "ERROR")) = 0),
ROW("Check","Forecast units","Pass",ABS([Total Forecasted Units]-12563212.29501853)<0.00001),
ROW("Check","Stores","Pass",[Stores]=54),
ROW("Check","Families","Pass",[Product Families]=33),
ROW("Check","Series","Pass",[Combinations]=1782),
ROW("Check","Daily rows","Pass",COUNTROWS(FactForecast)=28512),
ROW("Check","Low","Pass",CALCULATE([Combinations],DimRiskCategory[risk_category]="Low")=537),
ROW("Check","Medium","Pass",CALCULATE([Combinations],DimRiskCategory[risk_category]="Medium")=941),
ROW("Check","High","Pass",[High Risk Count]=286),
ROW("Check","Critical","Pass",[Critical Risk Count]=18),
ROW("Check","High Critical","Pass",[High Critical Count]=304),
ROW("Check","P1","Pass",[P1 Actions]=123),
ROW("Check","P2","Pass",[P2 Actions]=1122),
ROW("Check","P3 remains available","Pass",[P3 Actions]=537),
ROW("Check","Mean risk","Pass",ABS([Average Risk Score]-48.65701459034793)<0.0000001),
ROW("Check","Exposure units","Pass",ABS([At Risk Forecasted Units]-658722.2887359052)<0.00001),
ROW("Check","Exposure share","Pass",ABS([At Risk Exposure Share]-658722.2887359052/12563212.29501853)<0.0000001),
ROW("Check","Model RMSLE","Pass",[Selected Model RMSLE]=0.3942),
ROW("Check","Baseline RMSLE","Pass",[Baseline RMSLE]=0.4693),
ROW("Check","Improvement","Pass",ABS([Relative Model Improvement]-(1-0.3942/0.4693))<0.0000001),
ROW("Check","Date filters forecast","Pass",ABS(CALCULATE([Total Forecasted Units],DimDate[date]=DATE(2017,8,16))-816013.6654999685)<0.00001),
ROW("Check","Dates preserve risk snapshot","Pass",CALCULATE([Combinations],DimDate[date]=DATE(2017,8,16))=1782),
ROW("Check","P1 plus P2 context","Pass",CALCULATE([Combinations],DimPriority[action_priority] IN {"P1 - Immediate review","P2 - Monitor"})=1245)
)