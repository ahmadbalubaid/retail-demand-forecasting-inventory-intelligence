                "    Typed = Table.TransformColumnTypes(Headers, {{\"action_priority\", type text}, {\"priority_order\", Int64.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ],
              "type": "m"
            }
          }
        ]
      },
      {
        "name": "FactForecast",
        "columns": [
          {
            "name": "date",
            "annotations": [
              {
                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ],
            "dataType": "dateTime",
            "formatString": "dd MMM yyyy",
            "lineageTag": "92a99bb4-ffe5-4f26-8e21-60765c1287c6",
            "sourceColumn": "date",
            "summarizeBy": "none"
          },
          {
            "name": "series_key",
            "dataType": "string",
            "isHidden": true,
            "lineageTag": "10ab49dc-e0a9-46fe-b6f8-dba3b8ddb368",
            "sourceColumn": "series_key",
            "summarizeBy": "none"
          },
          {
            "name": "predicted_sales",
            "dataType": "double",
            "lineageTag": "eb13ac6b-1bfb-4350-8a68-05d7a31d7060",
            "sourceColumn": "predicted_sales",
            "summarizeBy": "none"
          },
          {
            "name": "onpromotion",
            "dataType": "int64",
            "lineageTag": "80f1130d-b972-4167-8dbb-f41a6dee8661",
            "sourceColumn": "onpromotion",
            "summarizeBy": "none"
          },
          {
            "name": "forecast_horizon",
            "dataType": "int64",
            "lineageTag": "952189cd-e1ac-4f14-8a09-f622d17b9c79",
            "sourceColumn": "forecast_horizon",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "0af046e2-92b3-46ee-b141-70ba8a4a7979",
        "measures": [
          {
            "name": "Total Forecasted Units",
            "description": "Sum of daily predicted sales in current date and series context. Historical case study, units.",
            "displayFolder": "Forecast",
            "expression": "SUM(FactForecast[predicted_sales])",
            "formatString": "#,0",
            "lineageTag": "d401059a-7faa-4812-bf50-78c6df1d3157"
          },
          {
            "name": "Average Daily Forecast",
            "description": "Selected forecast units / selected calendar days. Risk metrics remain full-horizon snapshots.",
            "displayFolder": "Forecast",
            "expression": "DIVIDE([Total Forecasted Units], DISTINCTCOUNT(DimDate[date]))",
            "formatString": "#,0.0",
            "lineageTag": "54a0c1bb-39b8-4b43-8c9c-063c24fee5cf"
          },
          {
            "name": "Stores",
            "description": "Stores",
            "displayFolder": "Coverage",
            "expression": "DISTINCTCOUNT(DimSeries[store_nbr])",
            "formatString": "#,0",
            "lineageTag": "1452378f-7d1f-434a-b37b-e28087d9f426"
          },
          {
            "name": "Product Families",
            "description": "Product Families",
            "displayFolder": "Coverage",
            "expression": "DISTINCTCOUNT(DimSeries[family_id])",
            "formatString": "#,0",
            "lineageTag": "cd6fd089-43de-414a-8cef-71bb584880c4"
          },
          {
            "name": "Combinations",
            "description": "Number of assessed store-family snapshots; unaffected by date slicers.",
            "displayFolder": "Risk",
            "expression": "COALESCE(COUNTROWS(FactInventoryRisk), 0)",
            "formatString": "#,0",
            "lineageTag": "98b59ac9-ef0c-4b86-809d-7de79000a5d2"
          },
          {
            "name": "Average Risk Score",
            "description": "Unweighted average of source risk scores; never sum scores.",
            "displayFolder": "Risk",
            "expression": "AVERAGE(FactInventoryRisk[demand_risk_score])",
            "formatString": "0.0",
            "lineageTag": "f5672b94-acb5-4e81-9fb1-2cfc073c49f5"
          },
          {
            "name": "High Risk Count",
            "description": "High Risk Count",
            "displayFolder": "Risk",
            "expression": "CALCULATE([Combinations], KEEPFILTERS(DimRiskCategory[risk_category] = \"High\"))",
            "formatString": "#,0",
            "lineageTag": "e0c2d8a6-55d2-4183-bf74-9af1ab318025"
          },
          {
            "name": "Critical Risk Count",
            "description": "Critical Risk Count",
            "displayFolder": "Risk",
            "expression": "CALCULATE([Combinations], KEEPFILTERS(DimRiskCategory[risk_category] = \"Critical\"))",
            "formatString": "#,0",
            "lineageTag": "3d7259a3-3d37-4b9c-a6fa-2bd9689b7b3a"
          },
          {
            "name": "High Critical Count",
            "description": "High Critical Count",
            "displayFolder": "Risk",
            "expression": "[High Risk Count] + [Critical Risk Count]",
            "formatString": "#,0",
            "lineageTag": "ea4e3959-d591-4fa5-95f2-823776cce99c"
          },
          {
            "name": "High Critical Percentage",
            "description": "High Critical Percentage",
            "displayFolder": "Risk",
            "expression": "DIVIDE([High Critical Count], [Combinations])",
            "formatString": "0.0%",
            "lineageTag": "8e1909d0-60ac-479b-846a-4189e6a63263"
          },
          {
            "name": "P1 Actions",
            "description": "P1 Actions",
            "displayFolder": "Actions",
            "expression": "CALCULATE([Combinations], KEEPFILTERS(DimPriority[action_priority] = \"P1 - Immediate review\"))",
            "formatString": "#,0",
            "lineageTag": "7642655d-3b49-4d1e-a883-a5926128de14"
          },
          {
            "name": "P2 Actions",
            "description": "P2 Actions",
            "displayFolder": "Actions",
            "expression": "CALCULATE([Combinations], KEEPFILTERS(DimPriority[action_priority] = \"P2 - Monitor\"))",
            "formatString": "#,0",
            "lineageTag": "67549087-ed8d-4804-8b25-e61297cce77d"
          },
          {
            "name": "P3 Actions",
            "description": "P3 Actions",
            "displayFolder": "Actions",
            "expression": "CALCULATE([Combinations], KEEPFILTERS(DimPriority[action_priority] = \"P3 - Routine\"))",
            "formatString": "#,0",
            "lineageTag": "3a9fe096-c90c-4150-9bc1-8db4513b9ae2"
          },
          {
            "name": "Surge Risk",
            "description": "Surge Risk",
            "displayFolder": "Risk",
            "expression": "AVERAGE(FactInventoryRisk[demand_surge_risk])",
            "formatString": "0.0",
            "lineageTag": "35026d62-64c0-47c9-b87e-34621a8e2ecc"
          },
          {
            "name": "Decline Risk",
            "description": "Decline Risk",
            "displayFolder": "Risk",
            "expression": "AVERAGE(FactInventoryRisk[demand_decline_risk])",
            "formatString": "0.0",
            "lineageTag": "2da36df8-e6d5-496c-9e1f-75004f4eb4f0"
          },
          {
            "name": "Volatility Risk",
            "description": "Volatility Risk",
            "displayFolder": "Risk",
            "expression": "AVERAGE(FactInventoryRisk[demand_volatility_risk])",
            "formatString": "0.0",
            "lineageTag": "82292225-85e1-427b-a7cd-444ea49c5dbe"
          },
          {
            "name": "Forecast Uncertainty",
            "description": "Forecast Uncertainty",
            "displayFolder": "Risk",
            "expression": "AVERAGE(FactInventoryRisk[forecast_uncertainty_score])",
            "formatString": "0.0",
            "lineageTag": "cd6f7a9f-96c1-4ae3-b9f9-41f7f305fde3"
          },
          {
            "name": "At Risk Forecasted Units",
            "description": "Daily forecast units for series classified High/Critical at origin; respects date selection.",
            "displayFolder": "Risk",
            "expression": "CALCULATE([Total Forecasted Units], KEEPFILTERS(DimRiskCategory[risk_category] IN {\"High\", \"Critical\"}))",
            "formatString": "#,0",
            "lineageTag": "8fdde67f-37c9-4f6a-a206-7e6c716eb32d"
          },
          {
            "name": "At Risk Exposure Share",
            "description": "At Risk Exposure Share",
            "displayFolder": "Risk",
            "expression": "DIVIDE([At Risk Forecasted Units], [Total Forecasted Units])",
            "formatString": "0.0%",
            "lineageTag": "0e5763c9-7c34-425a-9c90-da7d9c06c8f3"
          },
          {
            "name": "Promotion Associated Units",
            "description": "Forecast units on rows with at least one promoted item; association, not promotion lift.",
            "displayFolder": "Forecast",
            "expression": "CALCULATE([Total Forecasted Units], KEEPFILTERS(FactForecast[onpromotion] > 0))",
            "formatString": "#,0",
            "lineageTag": "24970f5b-b653-4a93-884e-31fbc363a3a1"
          },
          {
            "name": "Promotion Associated Share",
            "description": "Promotion Associated Share",
            "displayFolder": "Forecast",
            "expression": "DIVIDE([Promotion Associated Units], [Total Forecasted Units])",
            "formatString": "0.0%",
            "lineageTag": "79e83173-2630-48ca-bac9-2135ad20e512"
          },
          {
            "name": "Snapshot Forecast Units",
            "description": "Full 16-day snapshot; intentionally unaffected by DimDate.",
            "displayFolder": "Snapshot",
            "expression": "SUM(FactInventoryRisk[forecast_16d_total])",
            "formatString": "#,0",
            "lineageTag": "07a2d86f-3545-465b-aae5-77345403e14e"
          },
          {
            "name": "Historical Daily Baseline",
            "description": "Sum of origin-time 28-day average daily sales. Not historical daily observations.",
            "displayFolder": "Snapshot",
            "expression": "SUM(FactInventoryRisk[historical_28d_avg])",
            "formatString": "#,0.0",
            "lineageTag": "ac884872-b16a-4051-b74d-5d1b708db5de"
          },
          {
            "name": "Eligible Forecast Growth",
            "description": "Ratio of aggregate daily forecast to aggregate historical daily mean, active non-sparse series only; full horizon.",
            "displayFolder": "Snapshot",
            "expression": "VAR Eligible = FILTER(FactInventoryRisk, FactInventoryRisk[sparse_history] = 0 && RELATED(DimSeries[activity_status]) <> \"dormant\" && RELATED(DimSeries[activity_status]) <> \"never sold\") RETURN DIVIDE(SUMX(Eligible, FactInventoryRisk[forecast_daily_avg]), SUMX(Eligible, FactInventoryRisk[historical_28d_avg])) - 1",
            "formatString": "0.0%",
            "lineageTag": "1958e276-de11-4edf-80c0-9e6403e6e3bb"
          },
          {
            "name": "Series Forecast Units",
            "description": "Series Forecast Units",
            "displayFolder": "Snapshot",
            "expression": "SUM(FactInventoryRisk[forecast_16d_total])",
            "formatString": "#,0",
            "lineageTag": "747fc1a6-2b82-4ddf-bfd1-75175ccead70"
          },
          {
            "name": "Priority Score",
            "description": "Priority Score",
            "displayFolder": "Actions",
            "expression": "AVERAGE(FactInventoryRisk[priority_score])",
            "formatString": "0.0",
            "lineageTag": "1f5216a5-8bbb-4bdf-94fa-befd308ef46e"
          },
          {
            "name": "Store Validation RMSLE",
            "description": "Source pooled validation RMSLE repeated per series; use at store grain.",
            "displayFolder": "Validation",
            "expression": "AVERAGE(FactInventoryRisk[store_rmsle])",
            "formatString": "0.000",
            "lineageTag": "ee3ba9bd-a229-456c-bf21-542905f49d37"
          },
          {
            "name": "Family Validation RMSLE",
            "description": "Source pooled validation RMSLE repeated per series; use at family grain.",
            "displayFolder": "Validation",
            "expression": "AVERAGE(FactInventoryRisk[family_rmsle])",
            "formatString": "0.000",
            "lineageTag": "360bf8bd-5314-4436-a71d-a06ecc7b8899"
          },
          {
            "name": "Selected Model RMSLE",
            "description": "Documented fixed mean across five folds, rounded to 4 decimals; risk config has 0.39421.",
            "displayFolder": "Validation",
            "expression": "CALCULATE(MAX(ModelPerformance[mean_rmsle]), REMOVEFILTERS(ModelPerformance), ModelPerformance[selected] = 1)",
            "formatString": "0.0000",
            "lineageTag": "a7fa5814-152b-46c8-9a5d-c1f55f5a66c2"
          },
          {
            "name": "Baseline RMSLE",
            "description": "Baseline RMSLE",
            "displayFolder": "Validation",
            "expression": "CALCULATE(MAX(ModelPerformance[mean_rmsle]), REMOVEFILTERS(ModelPerformance), ModelPerformance[model] = \"Baseline \u00b7 same weekday\")",
            "formatString": "0.0000",
            "lineageTag": "6a32be5a-3276-47be-8241-22a5cbe4412f"
          },
          {
            "name": "Relative Model Improvement",
            "description": "Relative RMSLE reduction using documented rounded model means; not business savings.",
            "displayFolder": "Validation",
            "expression": "1 - DIVIDE([Selected Model RMSLE], [Baseline RMSLE])",
            "formatString": "0.0%",
            "lineageTag": "d766c351-454b-4803-a43f-9f31dcbdb07b"
          },
          {
            "name": "Model RMSLE",
            "description": "Model RMSLE",
            "displayFolder": "Validation",
            "expression": "MAX(ModelPerformance[mean_rmsle])",
            "formatString": "0.0000",
            "lineageTag": "9ab20e58-039c-420e-8ff9-59653bb1e0e1"
          },
          {
            "name": "Fold RMSLE",
            "description": "Fold RMSLE",
            "displayFolder": "Validation",
            "expression": "MAX(ValidationFolds[ensemble_rmsle])",
            "formatString": "0.0000",
            "lineageTag": "4662c8fc-040d-46cd-abff-b75324c0163d"
          },
          {
            "name": "Feature Gain Share",
            "description": "Four leading LightGBM features only; rounded documented shares; not full importance distribution.",
            "displayFolder": "Validation",
            "expression": "SUM(FeatureImportance[gain_share])",
            "formatString": "0.0%",
            "lineageTag": "c6a19fcc-0a1c-45f1-aee9-c9186c38f84e"
          },
          {
            "name": "Top 10 Store Forecast",
            "description": "Top 10 Store Forecast",
            "displayFolder": "Forecast",
            "expression": "IF(RANKX(ALLSELECTED(DimStore[store_label]), [Total Forecasted Units], , DESC, DENSE) <= 10, [Total Forecasted Units])",
            "formatString": "#,0",
            "lineageTag": "33ec2d72-c15b-44f0-93fa-2468e3b0eca6"
          },
          {
            "name": "Top 10 Family Forecast",
            "description": "Top 10 Family Forecast",
            "displayFolder": "Forecast",
            "expression": "IF(RANKX(ALLSELECTED(DimFamily[family]), [Total Forecasted Units], , DESC, DENSE) <= 10, [Total Forecasted Units])",
            "formatString": "#,0",
            "lineageTag": "05386244-f457-409f-836a-e627c4eb0758"
          },
          {
            "name": "Highest Risk Store",
            "description": "Highest unweighted average risk among current stores; deterministic store-number tie break.",
            "displayFolder": "Risk",
            "expression": "VAR T = TOPN(1, ADDCOLUMNS(VALUES(DimStore[store_nbr]), \"Score\", [Average Risk Score]), [Score], DESC, DimStore[store_nbr], ASC) RETURN CONCATENATEX(T, \"Store \" & DimStore[store_nbr], \", \")",
            "lineageTag": "9f873c73-c63b-4074-8b3e-1fd8dc336918"
          },
          {
            "name": "Highest Risk Family",
            "description": "Highest Risk Family",
            "displayFolder": "Risk",
            "expression": "VAR T = TOPN(1, ADDCOLUMNS(VALUES(DimFamily[family]), \"Score\", [Average Risk Score]), [Score], DESC, DimFamily[family], ASC) RETURN CONCATENATEX(T, DimFamily[family], \", \")",
            "lineageTag": "9f195b9e-0dd1-4086-a5d6-2adecb98a96e"
          },
          {
            "name": "Context Title",
            "description": "Context Title",
            "displayFolder": "Labels",
            "expression": "\"Forecast \u2022 \" & FORMAT(MIN(DimDate[date]), \"dd MMM\") & \"\u2013\" & FORMAT(MAX(DimDate[date]), \"dd MMM yyyy\")",
            "lineageTag": "552c00e0-df7b-4cd7-9206-83ad6244d7b6"
          },
          {
            "name": "Risk Color",
            "description": "Risk Color",
            "displayFolder": "Labels",
            "expression": "SWITCH(SELECTEDVALUE(DimRiskCategory[risk_category]), \"Low\", \"#36D6A0\", \"Medium\", \"#F5C35B\", \"High\", \"#FF9457\", \"Critical\", \"#FF5E70\", \"#4EAEFF\")",
            "lineageTag": "23f25251-56d4-4e25-8f9e-0bdcf17b587e"
          },
          {
            "name": "Risk Heat Color",
            "description": "Matrix cell fill based on average risk and source right-closed thresholds.",
            "displayFolder": "Labels",
            "expression": "SWITCH(TRUE(), [Average Risk Score] <= 40, \"#186F5A\", [Average Risk Score] <= 65, \"#725723\", [Average Risk Score] <= 85, \"#8C4726\", \"#962C45\")",
            "lineageTag": "0de2870f-cb32-4637-b639-17fef68771d9"
          }
        ],
        "partitions": [
          {
            "name": "FactForecast",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataRoot & \"/FactForecast.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"date\", type date}, {\"series_key\", type text}, {\"predicted_sales\", type number}, {\"onpromotion\", Int64.Type}, {\"forecast_horizon\", Int64.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ],
              "type": "m"
            }
          }
        ]
      },
