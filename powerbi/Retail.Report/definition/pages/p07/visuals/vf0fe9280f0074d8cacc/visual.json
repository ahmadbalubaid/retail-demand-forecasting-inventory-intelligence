                  {
                    "value": "Historical case study; no live monitoring. Origin: 15 Aug 2017.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "14px",
                      "color": "#91A5BC"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Forecast: 16–31 Aug 2017. History averages are indicators, not daily actuals.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "14px",
                      "color": "#91A5BC"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Risk is fixed at origin; dates filter forecasts, not risk snapshots.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "14px",
                      "color": "#91A5BC"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Inventory levels, lead times and supplier constraints are unavailable.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "14px",
                      "color": "#91A5BC"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Do not derive purchasing quantities directly from this report.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "14px",
                      "color": "#91A5BC"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Tuning reused validation folds; reported results may be optimistic.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "14px",
                      "color": "#91A5BC"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "RMSLE reduction is not savings; promotion association is not causal uplift.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "14px",
                      "color": "#91A5BC"
                    }
                  }
                ]
              }
            ]
